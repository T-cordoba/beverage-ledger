# Copia este archivo como .env (ignorado por git) y complétalo. Nunca subas claves reales.

# Proveedor de IA: ollama (local, por defecto, como en el proyecto del profesor) o gemini.
AI_PROVIDER=ollama

# Ollama local: no necesita clave externa. Stagehand 4.3.0 no tiene proveedor
# ollama nativo; support/ollama-client.mts usa su API compatible con OpenAI.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b

# Opcional, solo con AI_PROVIDER=gemini. Clave en https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
STAGEHAND_MODEL=google/gemini-2.5-flash

# Cuenta MANAGER del entorno LOCAL (registra entradas, salidas, ajustes, traspasos y anula).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Entorno local y desechable: la suite se niega a correr contra otra cosa que localhost.
STAGEHAND_BASE_URL=http://localhost:3000
STAGEHAND_API_URL=http://localhost:3001

# Navegador local. CHROME_PATH es opcional si Chrome está en la ruta por defecto.
HEADLESS=false
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
STAGEHAND_LOG_LEVEL=info
