# Copy to `.env` and fill in. `.env` is gitignored: never commit real credentials.

# Postgres behind the current server actions (`src/app/actions*.ts`). Goes away
# once the frontend cuts over to the NestJS API; after that this repo talks to
# no database at all.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Base URL of beverage-ledger-api.
# NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
