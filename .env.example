# Copy to `.env` and fill in. `.env` is gitignored: never commit real credentials.

# Origin of beverage-ledger-api, with no path. Every generated operation already
# carries the `/api/v1` prefix, so the base URL stops at the host; `pnpm
# api:types` reads the OpenAPI document from `/docs-json`, outside that prefix.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Set to "true" only when the API has Google credentials configured. Without
# them those routes answer 501, so the button stays hidden.
NEXT_PUBLIC_GOOGLE_SIGN_IN="false"

# Product name for the surfaces that run before there is a session: the landing,
# the auth screens and the document title. Once signed in the organization's own
# name takes over. Leave it unset to keep the default.
NEXT_PUBLIC_BRAND_NAME=""

# Account the tests that sign in use (tests/ and the Serenity/JS E2E suite).
# A real user of the organization; never commit its values.
TEST_USER_EMAIL=""
TEST_USER_PASSWORD=""

# E2E (pnpm test:e2e). The front the actor browses, and the API it also calls
# directly; the API has to be the same one the front talks to. Unset, they fall
# back to http://localhost:3000 and NEXT_PUBLIC_API_URL. HEADLESS=false shows
# the browser.
E2E_BASE_URL="http://localhost:3000"
E2E_API_URL=""
HEADLESS="true"

# Visual testing (pnpm test:visual), @applitools/eyes-cypress. From the
# Applitools dashboard; without it the @visual scenarios fail to open a session.
APPLITOOLS_API_KEY=""
